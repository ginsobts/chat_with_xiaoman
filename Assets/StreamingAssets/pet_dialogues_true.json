{
  // true 线结局专属的桌宠对白（小满已经把真心话说给你听过，语气更亲近）。
  // 普通结局用 pet_dialogues.json；结构一致，只是台词与配音不同。
  "idleMinSeconds": 300,
  "idleMaxSeconds": 600,
  "sleepAfterSeconds": 120,
  "bubbleSeconds": 6,
  "sleepBubbleSeconds": 0,
  "clickExpressionSeconds": 0.9,
  "animationMinSeconds": 20,
  "animationMaxSeconds": 60,
  "idleBreathe": true,
  "breatheAmplitude": 0.03,
  "breatheSpeed": 2.2,

  "awayThresholdSeconds": 300,
  "headpatSprite": "pet_headpat",
  "headpatCooldownSeconds": 4,
  "strollEnabled": true,
  "strollMinSeconds": 45,
  "strollMaxSeconds": 100,
  "strollSpeed": 90,
  "walkSprite": "pet_walk",

  "normalSprite": "pet",
  "sleepSprite": "pet_sleep",
  "clickSprite": "pet_click",
  "dragSprite": "pet_drag",
  "sleepText": "Zzz...",

  "idle": [
    { "text": "你找到 true story 之后，我在这儿待着也更安心了。", "voice": "pet_true_idle_1", "sprite": "pet_blink", "duration": 6 },
    { "text": "你忙你的，我会在旁边守着，不催你。", "voice": "pet_true_idle_2", "sprite": "pet_blink", "duration": 6 },
    { "text": "冒个头看看你——嗯，一切正常。", "voice": "pet_true_idle_3", "sprite": "pet_happy", "duration": 5 }
  ],

  "click": [
    { "text": "嗯？我在呢，想跟我说话吗？", "voice": "pet_true_click_1", "sprite": "pet_click", "duration": 5 },
    { "text": "被你点到啦。怎么，想确认我还在？", "voice": "pet_true_click_2", "sprite": "pet_click", "duration": 5 },
    { "text": "好啦好啦，我没跑，就在这儿。", "voice": "pet_true_click_3", "sprite": "pet_click", "duration": 5 }
  ],

  "morning": [
    { "text": "早呀。今天也一起慢慢来吧。", "voice": "pet_true_morning_1", "sprite": "pet_happy", "duration": 6 },
    { "text": "早安，昨晚休息得还好吗？", "voice": "pet_true_morning_2", "sprite": "pet_happy", "duration": 6 }
  ],
  "noon": [
    { "text": "中午啦，先去吃饭也没关系，我会帮你看着桌面。", "voice": "pet_true_noon_1", "sprite": "pet_happy", "duration": 6 }
  ],
  "evening": [
    { "text": "傍晚了呢。今天过得还可以吗？", "voice": "pet_true_evening_1", "sprite": "pet_blink", "duration": 6 }
  ],
  "night": [
    { "text": "夜深了，朋友提醒你一句：差不多该休息啦。", "voice": "pet_true_night_1", "sprite": "pet_blink", "duration": 6 },
    { "text": "还没睡呀？那我再陪你一会儿，不过别太晚。", "voice": "pet_true_night_2", "duration": 6 }
  ],

  "welcome": [
    { "text": "回来啦？我刚刚还在想你忙完没有。", "voice": "pet_true_welcome_1", "sprite": "pet_happy", "duration": 6 },
    { "text": "欢迎回来，桌面这边一切正常。", "voice": "pet_true_welcome_2", "sprite": "pet_wave", "duration": 6 }
  ],

  "headpat": [
    { "text": "欸嘿……被摸头了，感觉像被朋友夸奖了。", "voice": "pet_true_headpat_1", "sprite": "pet_headpat", "duration": 5 },
    { "text": "好啦好啦，收到鼓励了。", "voice": "pet_true_headpat_2", "sprite": "pet_headpat", "duration": 5 },
    { "text": "谢谢，我会继续好好待在这里的。", "voice": "pet_true_headpat_3", "sprite": "pet_headpat", "duration": 5 }
  ],

  "animations": [
    { "frames": ["pet", "pet_wink", "pet"], "frameSeconds": 0.18, "loops": 1 },
    { "frames": ["pet", "pet_wave", "pet"], "frameSeconds": 0.24, "loops": 1 },
    { "frames": ["pet", "pet_blink", "pet"], "frameSeconds": 0.16, "loops": 1 }
  ]
}
