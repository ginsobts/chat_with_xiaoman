          "variable": "player_identity",
          "equals": "unsure",
          "next": "demo_memory_unsure"
        }
      ],
      "next": "demo_memory_default"
    },
    {
      "id": "demo_memory_creator",
      "speaker": "小满",
      "text": "对了，我刚刚一直记着呢。你说你是创造我的人。",
      "next": "demo_memory_creator_2",
      "setVariables": [
        {
          "name": "xiaoxing_remembered_identity",
          "value": "yes"
        }
      ],
      "characters": [
        {
          "sprite": "xiaoyi_thinking",
          "position": "center"
        }
      ]
    },
    {
      "id": "demo_memory_creator_2",
      "speaker": "小满",
      "text": "所以我有点好奇……做出我的时候，你在想什么呀。",
      "next": "n13",
      "characters": [
        {
          "sprite": "xiaoman_curious",
          "position": "center"
        }
      ]
    },
    {
      "id": "demo_memory_visitor",
      "speaker": "小满",
      "text": "对了，我记得你说你只是来看看我。",
      "next": "demo_memory_visitor_2",
      "setVariables": [
        {
          "name": "xiaoxing_remembered_identity",
          "value": "yes"
        }
      ],
      "characters": [
        {
          "sprite": "xiaoyi_smile",
          "position": "center"
        }
      ]
    },
    {
      "id": "demo_memory_visitor_2",
      "speaker": "小满",
      "text": "那也很好。只是看看也没关系，能被你看到我就已经很开心了。",
      "next": "n13",
      "characters": [
        {
          "sprite": "xiaoman_relieved",
          "position": "center"
        }
      ]
    },
    {
      "id": "demo_memory_unsure",
      "speaker": "小满",
      "text": "你刚才说自己也说不清是谁，我还记得。",
      "next": "demo_memory_unsure_2",
      "setVariables": [
        {
          "name": "xiaoxing_remembered_identity",
          "value": "yes"
        }
      ],
      "characters": [
        {
          "sprite": "xiaoman_hesitant",
          "position": "center"
        }
      ]
    },
    {
      "id": "demo_memory_unsure_2",
      "speaker": "小满",
      "text": "其实没关系啦。有时候我也说不清自己到底算什么。",
      "next": "n13",
      "characters": [
        {
          "sprite": "xiaoyi_soft",
          "position": "center"
        }
      ]
    },
    {
      "id": "demo_memory_default",
      "speaker": "小满",
      "text": "我刚才好像想起了什么，但又有点不确定。算啦，先不说这个。",
      "next": "n13",
      "characters": [
        {
          "sprite": "xiaoman_awkward",
          "position": "center"
        }
      ]
    },
    {
      "id": "tamper",
      "background": "bg_glitch",
